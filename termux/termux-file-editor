#!/data/data/com.termux/files/usr/bin/bash
# Termux runs this when you share a file to Termux and pick "Edit"
# (installed into ~/bin/ by install.sh). Converts the PDF and saves the DOCX in Download.
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
pdf="$1"

case "${pdf,,}" in
  *.pdf) ;;
  *) echo "Not a PDF: $pdf"; read -rp "Press Enter to close"; exit 1 ;;
esac

dest="$HOME/storage/downloads/$(basename "${pdf%.*}").docx"
if python "$HERE/convert.py" "$pdf" "$dest"; then
  # The received PDF is a temporary copy made by Termux: delete it.
  rm -f "$pdf"
  echo "Saved in Download: $(basename "$dest")"
  termux-open "$dest" || true
else
  echo "Conversion failed."
fi
read -rp "Press Enter to close"
